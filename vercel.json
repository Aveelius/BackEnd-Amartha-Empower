{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/build/assets/(.*)",
      "dest": "/public/build/assets/$1"
    },
    {
      "src": "/build/manifest.json",
      "dest": "/public/build/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ]
}